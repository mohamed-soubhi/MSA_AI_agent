# Copy to .env and adjust. All vars are BE_-prefixed (see app/core/config.py).

BE_HOST=0.0.0.0
BE_PORT=8000

# Comma-separated frontend origins allowed to call this API (CORS).
# Empty = no cross-origin access at all. Set once the UI exists, e.g.:
# BE_CORS_ORIGINS=http://localhost:3000
BE_CORS_ORIGINS=

BE_LOG_LEVEL=info

# How long (seconds) the chat page's "Auto-approve" checkbox waits with
# no click before auto-approving a pending confirm() request.
# BE_AUTO_APPROVE_SECONDS=30

# NOT BE_-prefixed on purpose -- Ollama's own env var convention, read
# directly by app/api/models.py for GET /api/models/catalog (browses
# ollama.com's full cloud model list). Only needed if that endpoint
# ever requires auth for your account; unauthenticated access works
# today. Sent as `Authorization: Bearer <value>`.
# OLLAMA_API_KEY=
