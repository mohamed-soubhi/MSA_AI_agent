# Copy to .env and adjust. Loaded automatically by agent_config.py /
# log_config.py on import (via python-dotenv), and by the config editor
# at BE/app/static/config.html -> GET/POST /api/config, which reads and
# writes this exact file. Every line here is optional -- omit anything
# you want left at its built-in default (shown as a comment below).

# -- Chat / Ollama ----------------------------------------------------
# WORKSHOP_MODEL=glm-5.2:cloud
# CHAT_TIMEOUT_SECONDS=60
# CHAT_MAX_RETRIES=2
# CHAT_RETRY_BACKOFF_SECONDS=2

# -- Tool loop ----------------------------------------------------------
# MAX_ITERATIONS=40
# MAX_WALL_SECONDS=600
# TOOL_TIMEOUT_SECONDS=30
# MAX_REPEAT_CALLS=3
# MAX_OBSERVATION_CHARS=4000

# -- Filesystem / sandbox -----------------------------------------------
# WORKSPACE_DIR=<project_root>/workspace
# MAX_WRITE_BYTES=2000000
# REQUIRE_CONFIRMATION=true

# -- Shell tools -------------------------------------------------------
# SHELL_ALLOWED=python,python3,ls,cat,echo,pip,pytest,node,npm,mkdir,cd
# SHELL_BLOCKED=rm ,rm-,sudo,mkfs,dd ,:(){,> /dev,curl ,wget ,chmod ,mv /
# SHELL_TIMEOUT_SECONDS=120
# SHELL_MAX_OUTPUT_LINES=50

# -- confirm() ------------------------------------------------------------
# CONFIRM_TIMEOUT_SECONDS=120
# CONFIRM_MAX_ACTION_LEN=400

# -- Auto mode -----------------------------------------------------------
# MAX_AUTO_TOOL_CALLS=30

# -- Memory --------------------------------------------------------------
# MEMORY_ENABLED=true
# MEMORY_FILE=<project_root>/memory.json
# MEMORY_MAX_ENTRIES=500
# MEMORY_MAX_TEXT_CHARS=1000
# MEMORY_MAX_RECALL_RESULTS=10
# MEMORY_SUMMARY_MAX_MESSAGES=40

# -- System prompt ---------------------------------------------------------
# SYSTEM_PROMPT="You are an AI software engineering assistant. ..."

# -- Logging ---------------------------------------------------------------
# LOG_ENABLED=true
# LOG_DIR=<project_root>/logs
# LOG_FILE_MODE=per_run
# SINGLE_LOG_FILENAME=chat.jsonl
# MAX_FIELD_CHARS=4000
# MAX_LOG_FILE_BYTES=10000000
# LOG_MODEL_TIMING=true
# ECHO_TO_TERMINAL=false
# MASK_SECRETS=true
