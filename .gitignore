# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Python virtual environments (BE/.venv, etc.)
.venv/
venv/

# Node / JS
node_modules/
npm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example

# OS artifacts
.DS_Store
Thumbs.db

# Run session logs (keep directory with .gitkeep)
logs/*.jsonl

# Persistent agent memory (local, per-user learned state)
memory.json

# Agent sandbox -- everything the agent builds/writes lives here.
# Keep the directory itself (.gitkeep) but not its generated contents.
workspace/*
!workspace/.gitkeep
